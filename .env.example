# ControlHub configuration reference.
#
# Local development does NOT use this file: `just bootstrap` generates random
# per-service credentials into the gitignored `.controlhub/` directory
# (infra.env, services.env, demo.env, local-credentials.json).
#
# This file documents the variables a non-local deployment has to provide.
# Never put real values here and never commit a filled-in copy.
# All variables are server-side. The web app exposes no NEXT_PUBLIC_* settings.

# --- common -----------------------------------------------------------------
# `dev` disables the Secure cookie flag for plain-http localhost. Any other
# value (default: production) enforces it.
CONTROLHUB_ENV=production
CONTROLHUB_LOG_FORMAT=json
CONTROLHUB_KAFKA_BROKERS=kafka-1:9092
CONTROLHUB_CLICKHOUSE_URL=http://clickhouse:8123
CONTROLHUB_CLICKHOUSE_DATABASE=controlhub

# --- ingest (OTLP HTTP :4318, OTLP gRPC :4317, admin :9464) ------------------
CONTROLHUB_INGEST_HTTP_ADDR=0.0.0.0:4318
CONTROLHUB_INGEST_GRPC_ADDR=0.0.0.0:4317
CONTROLHUB_INGEST_ADMIN_ADDR=127.0.0.1:9464
CONTROLHUB_INGEST_MAX_CONCURRENCY=512
CONTROLHUB_INGEST_DATABASE_URL=postgres://controlhub_ingest:<secret>@postgres:5432/controlhub
# Must be identical for ingest and processor.
CONTROLHUB_TOPIC_PARTITIONS=4

# --- processor (admin :9465) --------------------------------------------------
CONTROLHUB_PROCESSOR_ADMIN_ADDR=127.0.0.1:9465
CONTROLHUB_PROCESSOR_DATABASE_URL=postgres://controlhub_processor:<secret>@postgres:5432/controlhub
CONTROLHUB_PROCESSOR_CLICKHOUSE_USER=controlhub_processor
CONTROLHUB_PROCESSOR_CLICKHOUSE_PASSWORD=<secret>

# --- query API (:8080) --------------------------------------------------------
CONTROLHUB_API_ADDR=127.0.0.1:8080
CONTROLHUB_API_DATABASE_URL=postgres://controlhub_api:<secret>@postgres:5432/controlhub
CONTROLHUB_API_CLICKHOUSE_USER=controlhub_api
CONTROLHUB_API_CLICKHOUSE_PASSWORD=<secret>
# Comma-separated origins allowed to send cookie-authenticated mutations and login.
CONTROLHUB_ALLOWED_ORIGINS=https://controlhub.example.com

# --- action executor (separate process; the only one allowed to use Docker) ---
CONTROLHUB_EXECUTOR_DATABASE_URL=postgres://controlhub_executor:<secret>@postgres:5432/controlhub
CONTROLHUB_EXECUTOR_CLICKHOUSE_USER=controlhub_executor
CONTROLHUB_EXECUTOR_CLICKHOUSE_PASSWORD=<secret>
# Demo adapter targets: loopback URLs only.
DEMO_GATEWAY_URL=http://127.0.0.1:7001
DEMO_ORDERS_URL=http://127.0.0.1:7002
CONTROLHUB_DEMO_DB_CONTAINER=controlhub-demo-postgres-1

# --- web (Next.js server) ------------------------------------------------------
# Where the Next.js server proxies /api/v1/* to. Server-side only.
CONTROLHUB_API_URL=http://127.0.0.1:8080

# --- instrumented application (@controlhub/sdk-node) --------------------------
CONTROLHUB_OTLP_ENDPOINT=https://ingest.controlhub.example.com
CONTROLHUB_INGEST_TOKEN=<scoped ingestion token>
CONTROLHUB_SERVICE_NAME=orders
CONTROLHUB_SERVICE_NAMESPACE=shop
CONTROLHUB_SERVICE_VERSION=1.0.0
CONTROLHUB_ENVIRONMENT=production
