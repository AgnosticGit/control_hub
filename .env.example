# karbird configuration reference.
#
# Local development does NOT use this file: `just bootstrap` generates random
# per-service credentials into the gitignored `.karbird/` directory
# (infra.env, services.env, demo.env, local-credentials.json) and creates
# settings.env with your editable settings (retention).
#
# This file documents the variables a non-local deployment has to provide.
# Never put real values here and never commit a filled-in copy.
# All variables are server-side. The web app exposes no NEXT_PUBLIC_* settings.

# --- common -----------------------------------------------------------------
# `dev` disables the Secure cookie flag for plain-http localhost. Any other
# value (default: production) enforces it.
KARBIRD_ENV=production
KARBIRD_LOG_FORMAT=json
KARBIRD_KAFKA_BROKERS=kafka-1:9092
KARBIRD_CLICKHOUSE_URL=http://clickhouse:8123
KARBIRD_CLICKHOUSE_DATABASE=karbird

# --- ClickHouse retention, days (2..3650), shared by bootstrap, API and archiver --
# `karbird-api bootstrap` sets these as the table TTLs. The API and the archiver
# compare them with the real TTL at startup and refuse to run on a mismatch, so
# change them only together with a bootstrap. Lengthening applies at once;
# shortening that deletes rows needs `bootstrap --shrink-retention`.
# Locally they live in .karbird/settings.env (see docs/operations/local-dev.md).
KARBIRD_LOGS_RETENTION_DAYS=14
KARBIRD_SPANS_RETENTION_DAYS=14
KARBIRD_EVENTS_RETENTION_DAYS=30
KARBIRD_METRICS_RETENTION_DAYS=14

# --- ingest (OTLP HTTP :4318, OTLP gRPC :4317, admin :9464) ------------------
KARBIRD_INGEST_HTTP_ADDR=0.0.0.0:4318
KARBIRD_INGEST_GRPC_ADDR=0.0.0.0:4317
KARBIRD_INGEST_ADMIN_ADDR=127.0.0.1:9464
# OTLP metric series accepted per environment per hour by each ingest instance; more are rejected and counted.
KARBIRD_INGEST_MAX_SERIES_PER_ENV=10000
KARBIRD_INGEST_MAX_CONCURRENCY=512
KARBIRD_INGEST_DATABASE_URL=postgres://karbird_ingest:<secret>@postgres:5432/karbird
# Must be identical for ingest and processor.
KARBIRD_TOPIC_PARTITIONS=4

# --- processor (admin :9465) --------------------------------------------------
KARBIRD_PROCESSOR_ADMIN_ADDR=127.0.0.1:9465
KARBIRD_PROCESSOR_DATABASE_URL=postgres://karbird_processor:<secret>@postgres:5432/karbird
KARBIRD_PROCESSOR_CLICKHOUSE_USER=karbird_processor
KARBIRD_PROCESSOR_CLICKHOUSE_PASSWORD=<secret>

# --- query API (:8080) --------------------------------------------------------
KARBIRD_API_ADDR=127.0.0.1:8080
KARBIRD_API_DATABASE_URL=postgres://karbird_api:<secret>@postgres:5432/karbird
KARBIRD_API_CLICKHOUSE_USER=karbird_api
KARBIRD_API_CLICKHOUSE_PASSWORD=<secret>
# Comma-separated origins allowed to send cookie-authenticated mutations and login.
KARBIRD_ALLOWED_ORIGINS=https://karbird.example.com
# Optional log archive (read-only keys). Without an endpoint logs come from ClickHouse only.
KARBIRD_API_S3_ACCESS_KEY=<read-only key>
KARBIRD_API_S3_SECRET_KEY=<secret>
# Optional: logs older than this are read from the archive by default. Defaults to
# one day less than KARBIRD_LOGS_RETENTION_DAYS; a value at or above it is a startup error.
# KARBIRD_ARCHIVE_HOT_WINDOW_HOURS=312

# --- log archive (ADR-0015), shared by archiver and API ------------------------
KARBIRD_ARCHIVE_S3_ENDPOINT=https://s3.example.com
KARBIRD_ARCHIVE_S3_BUCKET=karbird-archive
KARBIRD_ARCHIVE_S3_REGION=us-east-1

# --- archiver (admin :9466; reads ClickHouse, writes object storage) ----------
KARBIRD_ARCHIVER_ADMIN_ADDR=127.0.0.1:9466
KARBIRD_ARCHIVER_DATABASE_URL=postgres://karbird_archiver:<secret>@postgres:5432/karbird
KARBIRD_ARCHIVER_CLICKHOUSE_USER=karbird_archiver
KARBIRD_ARCHIVER_CLICKHOUSE_PASSWORD=<secret>
KARBIRD_ARCHIVER_S3_ACCESS_KEY=<read/write key for the archive bucket>
KARBIRD_ARCHIVER_S3_SECRET_KEY=<secret>
# How long archived log segments are kept in object storage.
KARBIRD_ARCHIVE_RETENTION_DAYS=365

# --- action executor (separate process; the only one allowed to use Docker) ---
KARBIRD_EXECUTOR_DATABASE_URL=postgres://karbird_executor:<secret>@postgres:5432/karbird
KARBIRD_EXECUTOR_CLICKHOUSE_USER=karbird_executor
KARBIRD_EXECUTOR_CLICKHOUSE_PASSWORD=<secret>
# Demo adapter targets: loopback URLs only.
DEMO_GATEWAY_URL=http://127.0.0.1:7001
DEMO_ORDERS_URL=http://127.0.0.1:7002
KARBIRD_DEMO_DB_CONTAINER=karbird-demo-postgres-1

# --- web (Next.js server) ------------------------------------------------------
# Where the Next.js server proxies /api/v1/* to. Server-side only.
KARBIRD_API_URL=http://127.0.0.1:8080

# --- instrumented application (@karbird/sdk-node) --------------------------
KARBIRD_OTLP_ENDPOINT=https://ingest.karbird.example.com
KARBIRD_INGEST_TOKEN=<scoped ingestion token>
KARBIRD_SERVICE_NAME=orders
KARBIRD_SERVICE_NAMESPACE=shop
KARBIRD_SERVICE_VERSION=1.0.0
KARBIRD_ENVIRONMENT=production
