{
  "name": "@controlhub/sdk-node",
  "version": "0.1.0",
  "private": true,
  "description": "ControlHub integration for Node.js HTTP services (OpenTelemetry-based)",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
